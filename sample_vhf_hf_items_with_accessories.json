  "Usage_Instructions": {
    "endpoint": "POST http://localhost:5000/api/items/receive",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_JWT_TOKEN"
    },
    "notes": [
      "Replace WarehouseId with actual warehouse ID from your database",
      "Ensure RegisteredBy matches the logged-in user",
      "Serial numbers must be unique across the entire system",
      "UnitPrice is mandatory for main items and optional for accessories",
      "Currency defaults to ETB if not specified",
      "Source can be: Purchase, Return, Donation, Transfer",
      "Condition can be: New, Used, Refurbished, Damaged",
      "RequiresSerialNumbers: set to true for accessories that need tracking",
      "SubAccessories are optional nested accessories within accessories"
    ]
  }
